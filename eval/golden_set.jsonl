//   difficulty: "easy", "medium", "hard"
//   category: "financial_metric", "risk_factor", "strategy", "comparison", "temporal", "unanswerable"
//
// This file will be populated in Day 4 with 100+ questions (~20 unanswerable).
// For now, here are seed examples showing the format:
